// washingtoninformation.com is published as static files on Cloudflare Workers.
// Cloudflare (Workers Builds) runs `npx wrangler deploy` on every push to main; no build step is needed
// because the generated pages are committed in public/.
{
  "name": "washington-information",
  "account_id": "85d2ba69d7730294ed5758d25f277d23",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
